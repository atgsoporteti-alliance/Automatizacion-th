# =============================================================================
# Alliance HCM – Core TH & IT (Fase 1 MVP)
# Copia este archivo como .env en la raíz del proyecto
# =============================================================================

# --- General ---
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- PostgreSQL 16 ---
POSTGRES_USER=alliance_hcm
POSTGRES_PASSWORD=alliance_hcm_secret
POSTGRES_DB=alliance_hcm_db
DATABASE_URL=postgresql://alliance_hcm:alliance_hcm_secret@localhost:5432/alliance_hcm_db

# --- Redis 7 (BullMQ Colas Asíncronas) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Supabase Storage S3 / MinIO (Expedientes PDF & Firmas) ---
# Para Supabase Storage: https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=alliance
S3_FORCE_PATH_STYLE=true

# --- Seguridad & Pre-Ingreso (Magic Link + OTP) ---
JWT_SECRET=alliance-hcm-dev-jwt-secret-change-in-production
MAGIC_LINK_EXPIRES_IN=72h
OTP_TTL_SECONDS=600

# --- Integración ManageEngine ServiceDesk Plus (Helpdesk) ---
HELPDESK_MOCK_ENABLED=true
SERVICEDESK_API_URL=https://servicedesk.alliance.local/api/v3
SERVICEDESK_API_KEY=your-servicedesk-technician-api-key
SERVICEDESK_WEBHOOK_SECRET=alliance-webhook-secret-dev

# --- Corporativo ---
CORPORATE_EMAIL_DOMAIN=alliance.com.co

# --- Supabase Auth (RBAC & SSO Google Workspace) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
NEXT_PUBLIC_DEV_AUTH_BYPASS=true
